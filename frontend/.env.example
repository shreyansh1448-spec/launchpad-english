# Same-origin /api is used by default (see src/api.js) - Pages Functions
# serve the API on the same domain as the frontend, both in production and
# in local dev via `wrangler pages dev` (proxied from Vite's :5173 to :8788,
# see vite.config.js). Uncomment only if pointing at a different deployment.
# VITE_API_URL=http://localhost:8788/api
