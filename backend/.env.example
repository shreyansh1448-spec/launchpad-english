PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/launchpad_english

# Razorpay - Dashboard > Settings > API Keys. Use rzp_test_* keys while
# developing, switch to rzp_live_* only when you're ready to accept real
# payments.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_SECRET

# Admin login (email + password) - used only once, to create the first admin
# account on a fresh database (see server.js bootstrapAdmin). After that,
# change the password/email from the admin panel instead of editing these.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Any long random string - signs the admin login session token (JWT).
# Changing this logs every admin out.
JWT_SECRET=choose-a-long-random-string

# Optional - only needed if you wire in a real SMS/OTP provider in
# routes/otp.js (MSG91 / Twilio / 2Factor). Not required for the demo OTP
# flow, which works out of the box.
# SMS_PROVIDER_API_KEY=
